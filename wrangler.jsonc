{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stdcore-landing",
  // TODO: pin to the StandardCore account id once `wrangler whoami` lists it.
  // Deliberately NOT set to 6fc7152072350c7ca7026cef91984cc8 — that is the
  // Get1threaded account, which must not host StandardCore infrastructure.
  // "account_id": "<standardcore-account-id>",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    // SPA, not a static multi-page site: every unmatched path must serve
    // index.html so React Router can handle /readiness-calculator, /admin, etc.
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
